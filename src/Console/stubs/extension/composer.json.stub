{
    "name": "{package}",
    "alias": "{pluginName}",
    "description": "{pluginDesc}",
    "type": "library",
    "keywords": ["ruiyi-laadmin", "extension"],
    "homepage": "https://github.com/{package}",
    "license": "MIT",
    "authors": [
        {
            "name": "{authorsName}",
            "email": "{authorsEmail}"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "rui-yi/la-admin": "~1.0"
    },
    "autoload": {
        "psr-4": {
            "{namespace}": "src/"
        }
    },
    "extra": {
        "ruiyi-laadmin": "{namespace}{className}ServiceProvider",
        "laravel": {
            "providers": [
                "{namespace}{className}ServiceProvider"
            ]
        }
    }
}
