{
    "name": "ruiyi/La-admin",
    "description": "一个基于larval的后台管理插件包，基于dcat-admin改造而来。",
    "type": "library",
    "keywords": ["ruiyi","saas", "laravel", "admin", "grid", "form", "laravel saas admin"],
    "homepage": "https://github.com/chendejue/ry-laadmin",
    "license": "MIT",
    "authors": [
        {
            "name": "陈德爵",
            "email": "chendejue@163.com"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "laravel/framework": "~8.0|~9.0|~10.0|~11.0|~12.0",
        "spatie/eloquent-sortable": "3.*|4.*",
        "doctrine/dbal": "^2.6|^3.0|^4.0",
        "dcat/easy-excel":"*",
        "tymon/jwt-auth":"^2.1",
        "maatwebsite/excel": "^3.1",
        "dedoc/scramble": "^0.12.22"
    },
    "require-dev": {
        "laravel/dusk": "~5.9|~6|~7.0|~8.0",
        "phpstan/phpstan": "^0.12.0|~1.0",
        "phpunit/phpunit": "^7.5|~9|~10|~11",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "RuiYi\\LaAdmin\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RuiYi\\LaAdmin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "RuiYi\\LaAdmin\\AdminServiceProvider"
            ]
        }
    }
}
